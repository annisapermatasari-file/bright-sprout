# Copy this file to .env and fill in real values.
# Never commit .env or any file containing real secrets.

# PostgreSQL connection string (Neon in production, e.g.
# postgresql://user:password@ep-example.neon.tech/counting_lms?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/counting_lms"

# Auth.js (NextAuth v5) configuration.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# DOKU Checkout (payment gateway). Get these from your DOKU Back Office.
# Sandbox Client-Id looks like "MCH-XXXX-XXXXXXXXXXXXX".
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Set to "true" only when using production DOKU credentials.
DOKU_IS_PRODUCTION=false

# Public base URL of this app, used to build DOKU's callback_url_result.
# In Vercel, set this to your production domain, e.g. https://bright-sprout-mu.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
